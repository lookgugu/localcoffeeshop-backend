# Server Configuration
PORT=3000
NODE_ENV=production

# Database
DB_PATH=./data/coffee_shops.db

# CORS - Frontend domains that can access this API
# For multiple origins, use comma-separated values
# Development: http://localhost:8080
# Production: https://localcoffeeshop.co,https://www.localcoffeeshop.co
CORS_ORIGIN=https://localcoffeeshop.co,https://www.localcoffeeshop.co

# Frontend URL for generating absolute URLs (sitemap, emails, etc.)
FRONTEND_URL=https://localcoffeeshop.co

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Analytics
GA_MEASUREMENT_ID=G-YVSXN7PM48

# Monitoring
METRICS_AUTH_TOKEN=
LOG_LEVEL=info

# Performance
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024
