# Server Configuration
PORT=3000
NODE_ENV=production

# Database
DB_PATH=./data/coffee_shops.db

# CORS - Frontend domains that can access this API
# For multiple origins, use comma-separated values
# Development: http://localhost:8080
# Production: https://localcoffeeshop.co,https://www.localcoffeeshop.co
CORS_ORIGIN=https://localcoffeeshop.co,https://www.localcoffeeshop.co

# Frontend URL for generating absolute URLs (sitemap, emails, etc.)
FRONTEND_URL=https://localcoffeeshop.co

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Community submissions (see docs/security/community-submissions.md)
# Production: closed (503) unless exactly "true". Do NOT enable until the
# durable-storage and reviewer-ownership release gate is met.
SUBMISSIONS_ENABLED=
# Integers only; invalid values fail the boot. 0-100000, 0 = accept nothing.
SUBMISSION_QUEUE_MAX=500
# Strict per-client budget for every POST/PUT/PATCH/DELETE under /api
# Window 1000-86400000 ms; max 1-10000 (0 is rejected — use SUBMISSIONS_ENABLED).
WRITE_RATE_LIMIT_WINDOW_MS=3600000
WRITE_RATE_LIMIT_MAX=10

# Analytics
GA_MEASUREMENT_ID=G-YVSXN7PM48

# Monitoring
METRICS_AUTH_TOKEN=
LOG_LEVEL=info

# Performance
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024

# Roaster-subscription INTEREST waitlist (see docs/waitlist.md).
# Fail-closed: 503 unless WAITLIST_ENABLED is exactly "true" AND every value
# below is present and valid. There is no fallback to RESEND_API_KEY or any
# other business's segment. Set secrets in the DO dashboard, never in git.
WAITLIST_ENABLED=
WAITLIST_RESEND_API_KEY=
# UUID of a Resend segment used ONLY for this list; the name must match the
# provider's segment name exactly and contain "localcoffeeshop".
WAITLIST_RESEND_SEGMENT_ID=
WAITLIST_RESEND_SEGMENT_NAME=
# A SEPARATE, already-provisioned segment used only as the LocalCoffeeShop
# opt-out list (never broadcast to it). Name must match exactly and contain
# "localcoffeeshop" and "suppression"/"unsubscribe"/"opt-out". Required.
WAITLIST_RESEND_SUPPRESSION_SEGMENT_ID=
WAITLIST_RESEND_SUPPRESSION_SEGMENT_NAME=
# >= 32 random characters, used only for waitlist tokens (openssl rand -base64 48)
WAITLIST_SIGNING_SECRET=
# Sender on the frontend domain (or a subdomain), verified in Resend
WAITLIST_FROM=Local Coffee Shops <waitlist@localcoffeeshop.co>
WAITLIST_REPLY_TO=
# Exact frontend origin; must also be listed in CORS_ORIGIN
WAITLIST_FRONTEND_ORIGIN=https://localcoffeeshop.co
WAITLIST_CONFIRM_TTL_HOURS=48
WAITLIST_IP_MAX=5
WAITLIST_IP_WINDOW_MS=3600000
WAITLIST_EMAIL_MAX_PER_DAY=3
WAITLIST_GLOBAL_SENDS_PER_HOUR=200
WAITLIST_PROVIDER_TIMEOUT_MS=5000
