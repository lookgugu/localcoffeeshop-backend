# Server Configuration
PORT=3000
NODE_ENV=production

# Database
DB_PATH=./data/coffee_shops.db

# CORS - Frontend domains that can access this API
# For multiple origins, use comma-separated values
# Development: http://localhost:8080
# Production: https://localcoffeeshop.co,https://www.localcoffeeshop.co
CORS_ORIGIN=https://localcoffeeshop.co,https://www.localcoffeeshop.co

# Frontend URL for generating absolute URLs (sitemap, emails, etc.)
FRONTEND_URL=https://localcoffeeshop.co

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Community submissions (see docs/security/community-submissions.md)
# Production: closed (503) unless exactly "true". Do NOT enable until the
# durable-storage and reviewer-ownership release gate is met.
SUBMISSIONS_ENABLED=
# Integers only; invalid values fail the boot. 0-100000, 0 = accept nothing.
SUBMISSION_QUEUE_MAX=500
# Strict per-client budget for every POST/PUT/PATCH/DELETE under /api
# Window 1000-86400000 ms; max 1-10000 (0 is rejected — use SUBMISSIONS_ENABLED).
WRITE_RATE_LIMIT_WINDOW_MS=3600000
WRITE_RATE_LIMIT_MAX=10

# Analytics
GA_MEASUREMENT_ID=G-YVSXN7PM48

# Monitoring
METRICS_AUTH_TOKEN=
LOG_LEVEL=info

# Performance
COMPRESSION_LEVEL=6
COMPRESSION_THRESHOLD=1024
